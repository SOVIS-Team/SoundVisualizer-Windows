<UserControl x:Class="SoundVisualizer.Ui.EasySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:SoundVisualizer.Ai;assembly=SoundVisualizer.Core"
             xmlns:core="clr-namespace:SoundVisualizer;assembly=SoundVisualizer.Core"
             xmlns:r="clr-namespace:SoundVisualizer.Rendering;assembly=SoundVisualizer.Core"
             xmlns:l="clr-namespace:SoundVisualizer.Localization"
             xmlns:ui="clr-namespace:SoundVisualizer.Ui"
             FontSize="14" FontWeight="Normal" Foreground="{StaticResource PrimaryTextBrush}">

    <!-- 설정 탭의 쉬운 설정(안드로이드 EasySettingsView, #408). 모양 → 크기 → 소리 종류 순서다. 안드로이드의 진동 줄과 빠른 설정 타일은 PC 에 없어 뺐다.
         색과 공통 서식은 Themes/Theme.xaml 에 있고, 여기에는 이 화면에만 쓰는 서식을 둔다. 왼쪽·오른쪽을 못 박지 않아
         아랍어에서는 런처가 뒤집는 대로 함께 뒤집힌다(모양 그림만 실제 방향이라 뒤집지 않는다, ModePreview).
         탭 머리 서식(20 굵게, 보조 글자색)이 탭 내용까지 물려 내려오므로 맨 위에서 본문 글자(14, 보통, 본 글자색)로 되돌린다. -->
    <UserControl.Resources>
        <!-- 구역 카드: 자세한 설정의 카드와 같은 모양이고 안쪽 여백만 16 이다(안드로이드 EasySection). 모양 카드 넷이 한 줄에 들어간다. -->
        <Style x:Key="EasyCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <Style x:Key="EasySection" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- 체크 표시. 고른 칸은 색에 더해 이 표시로도 보인다. 색만으로 알리지 않는다.
             오른쪽에서 왼쪽으로 쓰는 언어에서도 뒤집지 않는다. 뒤집으면 아래로 꺾인 화살표처럼 보인다(자리만 칸의 시작 쪽으로 옮겨 간다). -->
        <Style x:Key="CheckMark" TargetType="Path">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Data" Value="M 0,5 L 4,9 L 12,1"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 모양 카드: 실제 엔진으로 그린 작은 그림과 모드 이름. 고른 카드는 강조 바탕에 흰 글자(5.2:1)와 이름 앞 체크 표시,
             나머지는 조작 요소 바탕에 본 글자(10.4:1). 그림과 이름을 한 칸으로 읽고 그림은 읽지 않는다(서식 안의 글자는 따로 읽히지 않는다). -->
        <Style x:Key="ModeCard" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Background="{StaticResource ControlBrush}" CornerRadius="14" Padding="6">
                            <StackPanel>
                                <ui:ModePreview x:Name="Preview" Mode="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Grid HorizontalAlignment="Center" MinHeight="36" Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Check" Style="{StaticResource CheckMark}" Margin="0,0,6,0" Stroke="{TemplateBinding Foreground}"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCards" TargetType="ListBox" BasedOn="{StaticResource ChoiceChips}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModeCard}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ui:EqualChoicePanel Gap="10"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 크기 칸: 지금 모드의 모양을 그 크기로 줄인 그림과 낱말 하나. 고른 칸의 체크 표시는 칸 모서리에 둔다(낱말 앞에 두면 긴 번역어가
             좁은 칸에서 줄을 바꾼다, 안드로이드와 같다). 칸 높이는 64 이상이다. -->
        <Style x:Key="SizeChoice" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chip" Background="{StaticResource ControlBrush}" CornerRadius="12" MinHeight="64" Padding="4,10">
                                <StackPanel VerticalAlignment="Center">
                                    <ui:SizeStepIcon HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                                     Step="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                     Mode="{Binding CurrentMode, RelativeSource={RelativeSource AncestorType=ui:EasySettingsView}}"/>
                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </StackPanel>
                            </Border>
                            <Path x:Name="Check" Style="{StaticResource CheckMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                  Stroke="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeChoices" TargetType="ListBox" BasedOn="{StaticResource ChoiceChips}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource SizeChoice}"/>
        </Style>

        <!-- '자세한 설정' 칸: [조절 그림] 자세한 설정 ··· [체크] [>]. 크기 칸과 같은 색으로, 지금 값이 단계에 맞지 않으면 고른 칸처럼 보인다.
             가로로 길어 체크 표시를 낱말 뒤에 둔다. 화살표(>)는 오른쪽에서 왼쪽으로 쓰는 언어에서 함께 뒤집혀 앞으로 가는 쪽을 가리킨다. -->
        <Style x:Key="DetailedChoice" TargetType="ui:DetailedChoiceButton">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:DetailedChoiceButton">
                        <Border x:Name="Chip" Background="{StaticResource ControlBrush}" CornerRadius="12" MinHeight="48" Padding="12,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:DetailedIcon VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Path x:Name="Check" Grid.Column="2" Style="{StaticResource CheckMark}" Margin="0,0,8,0" Stroke="{TemplateBinding Foreground}"/>
                                <Path Grid.Column="3" VerticalAlignment="Center" Data="M 0,0 L 5,5 L 0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsCurrent" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsCurrent" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsCurrent" Value="True"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillPressedBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 소리 종류 줄: [종류 그림] 이름 ··· [눈] [스위치]. 줄 전체를 누르면 화면 표시가 켜지고 꺼진다(자세한 설정의 스위치 줄과 같다).
             종류 그림은 사용자가 정한 종류 색(Background 로 받는다)으로 칠한다. 색은 바꾸지 않고 보여 주기만 한다. 색 바꾸기는 자세한 설정에 있다.
             화면 읽어주기의 이름은 코드가 자세한 설정의 스위치 이름으로 단다(EasyNames.TypeRow). 그림과 눈은 이름과 스위치가 이미 말하는 것이라 읽지 않는다. -->
        <Style x:Key="TypeRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- 바탕을 투명하게라도 칠해야 글자 사이 빈 곳을 눌러도 켜고 끈다 -->
                        <Grid Background="Transparent" MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SoundTypeBadge VerticalAlignment="Center" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Background}"/>
                            <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ui:ShowIcon x:Name="Eye" Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"
                                         Shown="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Grid Grid.Column="3" Width="44" Height="24" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="12" Background="{StaticResource ControlBrush}"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource SecondaryTextBrush}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Eye" Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnFillBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Width" Value="18"/>
                                <Setter TargetName="Thumb" Property="Height" Value="18"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        </Style>
    </UserControl.Resources>

    <!-- 화면 읽어주기와 Tab 키의 차례는 보이는 차례와 같다: 모양 → 크기(칸 셋 → 안내 → '자세한 설정') → 소리 종류 셋.
         선택지 묶음 안의 순번("4개 중 2번째")은 칸을 놓은 차례로 매겨져 줄을 나눠도 보이는 차례와 같다(안드로이드 #434 에서 고친 것). -->
    <StackPanel>
        <TextBlock x:Name="TxtShapeTitle" Style="{StaticResource EasySection}" Text="{l:Loc easy.section.shape}"/>
        <Border Style="{StaticResource EasyCard}">
            <!-- 칸의 차례는 표현 모드 번호(AppSettings.VisualMode)와 같다. 고른 번호가 곧 모드다. -->
            <ui:ChoiceChipList x:Name="ModeCards" Style="{StaticResource ModeCards}" AutomationProperties.LabeledBy="{Binding ElementName=TxtShapeTitle}"
                               SelectionChanged="ModeCards_SelectionChanged"
                               PreviewMouseLeftButtonDown="ModeCards_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ModeCards_PreviewMouseLeftButtonUp"
                               PreviewKeyDown="ModeCards_PreviewKeyDown">
                <ListBoxItem Content="{l:Loc settings.mode.wave}" Tag="{x:Static r:VisualizerEngine.ModeWave}"/>
                <ListBoxItem Content="{l:Loc settings.mode.pad}" Tag="{x:Static r:VisualizerEngine.ModePad}"/>
                <ListBoxItem Content="{l:Loc settings.mode.circle}" Tag="{x:Static r:VisualizerEngine.ModeCircle}"/>
                <ListBoxItem Content="{l:Loc settings.mode.outline}" Tag="{x:Static r:VisualizerEngine.ModeOutline}"/>
            </ui:ChoiceChipList>
        </Border>

        <!-- 크기는 지금 모드의 것이라, 화면 읽어주기에는 "크기, 원형" 처럼 어느 모드의 크기인지 함께 읽힌다(이름은 코드가 단다). -->
        <TextBlock x:Name="TxtSizeTitle" Style="{StaticResource EasySection}" Text="{l:Loc easy.section.size}"/>
        <Border Style="{StaticResource EasyCard}">
            <StackPanel>
                <ui:ChoiceChipList x:Name="SizeChips" Style="{StaticResource SizeChoices}" SelectionChanged="SizeChips_SelectionChanged">
                    <ListBoxItem Content="{l:Loc easy.size.small}" Tag="{x:Static core:EasySize.Small}"/>
                    <ListBoxItem Content="{l:Loc easy.size.medium}" Tag="{x:Static core:EasySize.Medium}"/>
                    <ListBoxItem Content="{l:Loc easy.size.large}" Tag="{x:Static core:EasySize.Large}"/>
                </ui:ChoiceChipList>
                <!-- 자세한 설정에서 단계와 다르게 맞춘 크기면 어느 칸도 선택해 두지 않고 그 까닭과 할 일을 한 줄로 적는다(안드로이드 #425).
                     나타날 때 화면 읽어주기가 읽고 지나간다. -->
                <TextBlock x:Name="TxtSizeCustom" Style="{StaticResource Text.Description}" Margin="0,12,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite" Text="{l:Loc easy.size.custom}"/>
                <!-- 누르면 자세한 설정의 그 칸으로 간다(안드로이드 #427). 이름은 맨 위 두 칸의 '자세한 설정'과 같은 글자다. -->
                <ui:DetailedChoiceButton x:Name="BtnSizeDetailed" Style="{StaticResource DetailedChoice}" Margin="0,12,0,0"
                                         Content="{l:Loc settings.view.detailed}" Click="BtnSizeDetailed_Click"/>
            </StackPanel>
        </Border>

        <!-- 소리 종류: 위협음 → 대화음 → 환경음, 가장 중요한 종류부터(소리 탭과 같은 차례). 이름은 소리 탭의 종류 이름을 그대로 쓴다. -->
        <TextBlock Style="{StaticResource EasySection}" Text="{l:Loc easy.section.types}"/>
        <Border Style="{StaticResource EasyCard}">
            <StackPanel>
                <CheckBox x:Name="ChkDanger" Style="{StaticResource TypeRow}" Content="{l:Loc sounds.type.danger}" Tag="{x:Static ai:SoundType.Danger}"
                          Checked="TypeRow_Changed" Unchecked="TypeRow_Changed"/>
                <Border Style="{StaticResource TypeDivider}"/>
                <CheckBox x:Name="ChkSpeech" Style="{StaticResource TypeRow}" Content="{l:Loc sounds.type.speech}" Tag="{x:Static ai:SoundType.Speech}"
                          Checked="TypeRow_Changed" Unchecked="TypeRow_Changed"/>
                <Border Style="{StaticResource TypeDivider}"/>
                <CheckBox x:Name="ChkAmbient" Style="{StaticResource TypeRow}" Content="{l:Loc sounds.type.ambient}" Tag="{x:Static ai:SoundType.Ambient}"
                          Checked="TypeRow_Changed" Unchecked="TypeRow_Changed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
